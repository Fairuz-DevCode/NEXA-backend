generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model addresses {
  id             Int      @id @default(autoincrement())
  user_id        Int
  label          String   @db.VarChar
  phone          String   @db.VarChar
  street_address String
  city           String   @db.VarChar
  postal_code    String   @db.VarChar
  country        String   @db.VarChar(255)
  orders         orders[]

  @@index([user_id])
}

model cart_items {
  id                 Int              @id @default(autoincrement())
  cart_id            Int
  product_id         Int
  product_variant_id Int
  quantity           Int              @default(1)
  carts              carts            @relation(fields: [cart_id], references: [id], onDelete: Cascade)
  products           products         @relation(fields: [product_id], references: [id], onDelete: Cascade)
  product_variants   product_variants @relation(fields: [product_variant_id], references: [id], onDelete: Cascade)

  @@index([cart_id])
  @@index([product_id])
  @@index([product_variant_id])
}

model carts {
  id         Int          @id @default(autoincrement())
  user_id    Int          @unique
  cart_items cart_items[]

  @@index([user_id])
}

model categories {
  id               Int          @id @default(autoincrement())
  name             String       @db.VarChar
  slug             String       @unique @db.VarChar
  parent_id        Int?
  categories       categories?  @relation("categoriesTocategories", fields: [parent_id], references: [id], onDelete: SetNull)
  other_categories categories[] @relation("categoriesTocategories")
  products         products[]

  @@index([parent_id])
}

model order_items {
  id           Int      @id @default(autoincrement())
  order_id     Int
  product_id   Int
  product_name String   @db.VarChar
  size         String   @db.VarChar
  price        Int
  quantity     Int
  orders       orders   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  products     products @relation(fields: [product_id], references: [id], onDelete: Restrict)

  @@index([order_id])
  @@index([product_id])
}

model orders {
  id            Int           @id @default(autoincrement())
  order_number  String        @unique @db.VarChar
  user_id       Int
  address_id    Int
  total_amount  Int
  shipping_cost Int
  status        status?       @default(pending)
  created_at    DateTime?     @default(now()) @db.Timestamp(6)
  order_items   order_items[]
  addresses     addresses     @relation(fields: [address_id], references: [id], onDelete: Restrict)
  payments      payments[]
  shippings     shippings[]

  @@index([user_id])
  @@index([order_number])
  @@index([address_id])
  @@index([status])
}

model payments {
  id                 Int                 @id @default(autoincrement())
  order_id           Int
  payment_type       String?             @db.VarChar
  transaction_status transaction_status?
  payment_url        String?
  created_at         DateTime?           @default(now()) @db.Timestamp(6)
  orders             orders              @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
}

model product_reviews {
  id         Int       @id @default(autoincrement())
  product_id Int
  user_id    Int
  rating     Int
  comment    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([product_id])
  @@index([user_id])
}

model product_variants {
  id         Int          @id @default(autoincrement())
  product_id Int
  size       String       @db.VarChar
  stock      Int          @default(0)
  cart_items cart_items[]
  products   products     @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@index([product_id])
}

model products {
  id               Int                @id @default(autoincrement())
  category_id      Int
  sku              String             @unique @db.VarChar
  name             String             @db.VarChar
  description      String?
  price            Int
  created_at       DateTime?          @default(now()) @db.Timestamp(6)
  deleted_at       DateTime?          @db.Timestamp(6)
  img_url          String             @db.VarChar(255)
  slug             String             @unique @db.VarChar
  gender           gender_type?       @default(unisex)
  cart_items       cart_items[]
  order_items      order_items[]
  product_reviews  product_reviews[]
  product_variants product_variants[]
  categories       categories         @relation(fields: [category_id], references: [id], onDelete: Restrict)
  wishlists        wishlists[]

  @@index([category_id])
  @@index([slug])
  @@index([gender])
  @@index([deleted_at])
}

model refresh_tokens {
  id         Int       @id @default(autoincrement())
  user_id    Int
  token      String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  expires_at DateTime  @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([token])
}

model shippings {
  id              Int              @id @default(autoincrement())
  order_id        Int
  courier_name    String           @db.VarChar
  tracking_number String?          @db.VarChar
  shipping_status shipping_status? @default(pending)
  shipped_at      DateTime?        @db.Timestamp(6)
  orders          orders           @relation(fields: [order_id], references: [id], onDelete: Cascade)

  @@index([order_id])
}

model users {
  id              Int               @id @default(autoincrement())
  name            String            @db.VarChar(100)
  email           String            @unique @db.VarChar(255)
  password        String            @db.VarChar(255)
  phone           String?           @db.VarChar(20)
  role            user_role?        @default(user)
  is_two_factor_enabled Boolean     @default(false)
  two_factor_secret     String?     @db.VarChar(255)
  google_id             String?     @unique @db.VarChar(255)
  created_at      DateTime?         @default(now()) @db.Timestamp(6)
  product_reviews product_reviews[]
  refresh_tokens  refresh_tokens[]
  wishlists       wishlists[]
  audit_logs      audit_logs[]
}

model audit_logs {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  action     String    @db.VarChar(100)
  method     String    @db.VarChar(10)
  path       String    @db.VarChar(255)
  status_code Int
  ip_address String    @db.VarChar(50)
  user_agent String?   @db.Text
  details    Json?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
}

model wishlists {
  id         Int       @id @default(autoincrement())
  user_id    Int
  product_id Int
  created_at DateTime? @default(now()) @db.Timestamp(6)
  products   products  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, product_id])
  @@index([user_id])
  @@index([product_id])
}

enum gender_type {
  men
  women
  unisex
  kids
}

enum shipping_status {
  pending
  in_transit
  out_for_delivery
  delivered
  failed
}

enum status {
  pending
  paid
  shipped
  completed
  cancel
}

enum transaction_status {
  pending
  settlement
  expire
  cancel
}

enum user_role {
  user
  admin
}

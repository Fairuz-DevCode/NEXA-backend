# Application
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=db_nexa
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DATABASE_URL="postgresql://postgres:your_secure_db_password@localhost:5432/db_nexa?connection_limit=20&pool_timeout=10"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets (Generate random 64-character strings for production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars

# Frontend Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Midtrans Payment Gateway
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false

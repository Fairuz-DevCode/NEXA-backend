// =========================================
// 1. AUTH & USER MANAGEMENT
// =========================================

Table users {
  id int [pk, increment]
  email varchar [unique, not null]
  password varchar [not null]
  name varchar [not null]
  phone varchar
  role role
  token text
  created_at timestamp
}

enum role{
  customer 
  admin
}

Table addresses {
  id int [pk, increment]
  user_id int [not null]
  label varchar [not null]
  phone varchar [not null]
  street_address text [not null]
  city varchar [not null]
  country varchar [not null, default : `Indonesia`]
  postal_code varchar [not null]
}

// =========================================
// 2. PRODUCT CATALOG & VARIANTS
// =========================================

Table categories {
  id int [pk, increment]
  name varchar [not null]
  slug varchar [unique, not null]
  parent_id int [null, ref: > categories.id]
}

Table products {
  id int [pk, increment]
  category_id int [not null]
  sku varchar [unique, not null]
  name varchar [not null]
  slug varchar [unique, not null]
  description text
  price int [not null]
  created_at timestamp
}

Table product_variants {
  id int [pk, increment]
  product_id int [not null]
  size varchar [not null]
  stock int [not null, default: 0]
}

// =========================================
// 3. SHOPPING CART
// =========================================

Table carts {
  id int [pk, increment]
  user_id int [not null]
}

Table cart_items {
  id int [pk, increment]
  cart_id int [not null]
  product_id int [not null]
  product_variant_id int [not null]
  quantity int [not null, default: 1]
}

// =========================================
// 4. ORDERS & TRANSACTIONS
// =========================================

Table orders {
  id int [pk, increment]
  order_number varchar [unique, not null]
  user_id int [not null]
  address_id int [not null]
  total_amount int [not null]
  shipping_cost int [not null]
  status status 
  created_at timestamp
}

enum status{
  pending
  paid
  shipped
  completed
  cancel
}

Table order_items {
  id int [pk, increment]
  order_id int [not null]
  product_id int [not null]
  product_name varchar [not null]
  size varchar [not null]
  price int [not null]
  quantity int [not null]
}

// =========================================
// 5. PAYMENT & SHIPPING
// =========================================

Table payments {
  id int [pk, increment]
  order_id int [not null]
  payment_type varchar
  transaction_status transaction_status
  payment_url text
  created_at timestamp
}

enum transaction_status{
  pending 
  settlement
  expire
  cancel
}

Table shippings {
  id int [pk, increment]
  order_id int [not null]
  courier_name varchar [not null]
  tracking_number varchar
  shipping_status shipping_status
  shipped_at timestamp
}
enum shipping_status {
  pending          
  in_transit      
  out_for_delivery 
  delivered       
  failed          
}

// =========================================
// RELATIONSHIPS (FOREIGN KEYS)
// =========================================

// User & Address
Ref: addresses.user_id > users.id

// Product & Category
Ref: products.category_id > categories.id

// Product & Variant
Ref: product_variants.product_id > products.id

// Cart Relations
Ref: carts.user_id > users.id
Ref: cart_items.cart_id > carts.id
Ref: cart_items.product_id > products.id
Ref: cart_items.product_variant_id > product_variants.id

// Order Relations
Ref: orders.user_id > users.id
Ref: orders.address_id > addresses.id
Ref: order_items.order_id > orders.id
Ref: order_items.product_id > products.id

// Payment & Shipping Relations
Ref: payments.order_id > orders.id
Ref: shippings.order_id > orders.id
